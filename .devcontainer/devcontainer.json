{
  "name": "Clew",
  "image": "ghcr.io/quietflare/clew-devcontainer:latest",
  "containerEnv": {
    "NXF_VER": "26.09.2-edge",
    "NXF_CACHE_MODE": "DEEP"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8770],
  "portsAttributes": {
    "8770": { "label": "Clew UI", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
