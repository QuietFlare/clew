  "submittedFiles": {
    "workflow": "version 1.0\n\nworkflow diamond {\n  input {\n    File raw\n    File calibration\n    File reference\n    Array[String] samples = [\"s1\", \"s2\"]\n  }\n  call prep { input: raw = raw }\n  call qc { input: prepped = prep.prepped }\n  scatter (s in samples) {\n    call analyse { input: prepped = prep.prepped, calibration = calibration, sample = s }\n  }\n  call report { input: analyses = analyse.analysis, qc = qc.qc, reference = reference }\n  output {\n    File report_out = report.report\n  }\n}\n\ntask prep {\n  input { File raw }\n  command { sort ~{raw} > prepped.csv }\n  output { File prepped = \"prepped.csv\" }\n  \n}\n\ntask qc {\n  input { File prepped }\n  command { wc -l ~{prepped} > qc.txt }\n  output { File qc = \"qc.txt\" }\n}\n\ntask analyse {\n  input {\n    File prepped\n    File calibration\n    String sample\n  }\n  command { cat ~{prepped} ~{calibration} > ~{sample}.analysis.txt; echo sample=~{sample} >> ~{sample}.analysis.txt }\n  output { File analysis = \"~{sample}.analysis.txt\" }\n  \n}\n\ntask report {\n  input {\n    Array[File] analyses\n    File qc\n    File reference\n  }\n  command { cat ~{sep=' ' analyses} ~{qc} ~{reference} > report.txt }\n  output { File report = \"report.txt\" }\n}\n",
    "root": "",
    "options": "{\n\n}",
    "inputs": "{\"diamond.raw\": \"/data/wdl/raw.csv\", \"diamond.calibration\": \"/data/wdl/calibration.txt\", \"diamond.reference\": \"/data/wdl/reference.txt\"}\n",
